# Test fixtures are tracked deliberately. The design's §6 fixture rule requires every binary
# fixture to be committed or derived by a test from a committed one, because the byte-level,
# tag-set, preview-digest and attribute assertions are statements about a real container and
# do not hold on a truncated stand-in. testdata/MANIFEST.json records the expected outcome for
# every file, and testdata/.baseline.md5 is the integrity tripwire the suite checks before it
# derives anything — both are text and both must travel with the repository.

# Tool output, not fixtures: the review folder is regenerated by every run.
testdata/_unprocessed/

__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
build/
dist/
*.egg-info/

# mutmut working tree (a mutated copy of src/ and tests/, plus a testdata symlink) and its run log.
mutants/
mutants.log
